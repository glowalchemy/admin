# Frontend (Vite) — copy to `.env` and adjust per environment.
#
# VITE_API_BASE_URL:
#   Backend origin (scheme + host + port, WITHOUT a trailing slash and WITHOUT /api).
#   - Development:  http://localhost:8000   (backend dev server)
#   - Staging/Prod: https://api.yourdomain.com
#   Leave empty to use same-origin requests (Vite dev proxy or the shared
#   deployment host). Never hardcode a production URL in source code.

VITE_API_BASE_URL=http://localhost:8000

# Backend Socket.IO origin. Defaults to VITE_API_BASE_URL (or same origin when empty).
VITE_SOCKET_URL=http://localhost:8000

# Vite dev proxy target (dev only). Defaults to http://localhost:8000.
VITE_PROXY_TARGET=http://localhost:8000
